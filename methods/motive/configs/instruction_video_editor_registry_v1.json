{
  "schema_version": "motive-instruction-video-editor-registry-v1",
  "source_document": "docs/codex/train/open_video_editing_models_under_5b.md",
  "scope": {
    "required_user_inputs": [
      "source_video",
      "instruction"
    ],
    "forbidden_user_inputs": [
      "mask",
      "bbox",
      "pose",
      "trajectory",
      "reference_image",
      "edited_keyframe",
      "target_video",
      "source_prompt",
      "target_prompt"
    ],
    "internal_automatic_analysis_allowed": true,
    "internal_analysis_is_never_a_required_user_input": true
  },
  "promotion_policy": {
    "representation_gate_required_before_renderer_probe": true,
    "renderer_probe_required_before_training": true,
    "cross_content_transfer_required": true,
    "minimum_distinct_renderers_for_training": 2,
    "same_representation_payload_required_across_contents": true
  },
