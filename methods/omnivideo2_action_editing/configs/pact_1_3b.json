{
  "format": "pact-omnivideo2-training-v2",
  "seed": 20260803,
  "model": {
    "max_context_len": 6144,
    "visual_patch_size": [1, 4, 4],
    "wan_patch_size": [1, 2, 2],
    "source_erasure_mode": "zero",
    "require_special_tokens": true,
    "train_visual_adapter": true,
    "train_vlm_projection": true,
    "gradient_checkpointing": true
  },
  "mask": {
