# Repository and upstream source trees
VIDEO_ACTION_EDITING_ROOT=/path/to/VideoActionEditing
BERNINI_OFFICIAL_ROOT=/path/to/third_party/Bernini
BERNINI_VEOMNI_ROOT=/path/to/third_party/VeOmni

# Base model and project data
BERNINI_ACTION_CHECKPOINT=/path/to/models/Bernini-R-1.3B-Diffusers
BERNINI_ACTION_RAW_PARQUET=/path/to/action_data/raw/action.parquet
BERNINI_ACTION_RAW_RECEIPT=/path/to/action_data/raw/receipt.json
BERNINI_ACTION_RAW_JOB_DONE=/path/to/action_data/raw/job_done.json
BERNINI_ACTION_PARQUET_DIR=/path/to/action_data/vae_rows
BERNINI_ACTION_DATASET_SUMMARY=/path/to/action_data/vae_rows/dataset_summary.json

# Outputs are deliberately outside the Git checkout
BERNINI_ACTION_VAE_OUTPUT=/path/to/experiments/vae_rows
BERNINI_ACTION_TRAIN_OUTPUT=/path/to/experiments/train
BERNINI_ACTION_ADAPTER_CHECKPOINT=/path/to/experiments/train/checkpoint-00000400
BERNINI_ACTION_SOURCE_VIDEO=/path/to/input/source.mp4
BERNINI_ACTION_INSTRUCTION="Make the subject perform the requested action while preserving identity and scene."
BERNINI_ACTION_INFERENCE_OUTPUT=/path/to/experiments/inference/edited.mp4

# Optional read-only MEV source and writable metadata output
MEV_SOURCE_ROOT=/path/to/read-only/MEV
ACTION_DATA_ROOT=/path/to/action-data-output
